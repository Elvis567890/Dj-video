<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ultimateAmber">#F97316</color>
    <color name="ultimateBackground">#0A0A0C</color>
    <color name="ultimateBlue">#3B82F6</color>
    <color name="ultimateIconBg">#0A0A0C</color>
    <string name="app_name">ULTIMATE</string>
    <style name="Theme.Ultimate" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ultimateBackground</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Ultimate.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ultimateBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Ultimate</item>
    </style>
</resources>